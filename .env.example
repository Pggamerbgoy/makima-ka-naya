# Makima v2 Environment Variables Configuration Example
# Copy this file to .env and fill in your actual credentials.

# AI & LLM Provider Keys
GEMINI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
HF_TOKEN=

# Model & Voice Overrides (Optional - defaults to gemini-3.8-live / Aoede)
MAKIMA_LIVE_MODEL=gemini-3.8-live
MAKIMA_VOICE_NAME=Aoede

# OAuth & Authentication
MAKIMA_GITHUB_CLIENT_ID=
MAKIMA_GITHUB_CLIENT_SECRET=
MAKIMA_GOOGLE_CLIENT_ID=
MAKIMA_GOOGLE_CLIENT_SECRET=

# Integrations (Optional)
DAYTONA_API_KEY=
DAYTONA_API_URL=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
